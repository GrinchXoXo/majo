# Majo production settings. Copy to deploy/.env.production on the SERVER,
# fill in, then `chmod 600 deploy/.env.production`. Never commit the real file
# and never paste its values into chats, tickets or screenshots.
# deploy/scripts/majo.sh check validates this file before every deploy.

# --- Domain and TLS ---
# A DNS A record for this name must point at the server before the first start.
MAJO_DOMAIN=majo.example.com
# Let's Encrypt account e-mail (expiry warnings only).
ACME_EMAIL=you@example.com

# --- Production database (NOT the dev Neon) ---
# Option A, managed Postgres created for production only (its own project,
# its own credentials). Keep sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST/majo?sslmode=require
# Option B, Postgres on this server: start with --profile localdb and use
#   DATABASE_URL=postgres://majo:<POSTGRES_PASSWORD>@postgres:5432/majo?sslmode=disable
# (the connection never leaves the server's private Docker network).
POSTGRES_PASSWORD=

# Optional: a substring of the dev database host (for example the dev Neon
# endpoint id). The deploy check refuses to start if DATABASE_URL contains it.
FORBIDDEN_DATABASE_HOSTS=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any long random string; enter the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret. Required: the backend refuses to start without it.
WHATSAPP_APP_SECRET=
# Approved utility template for vendor requests outside the 24-hour window
# (docs/pilot/whatsapp-templates.md). Empty = free text only.
VENDOR_REQUEST_TEMPLATE_NAME=
VENDOR_REQUEST_TEMPLATE_LANGUAGE=en

# --- Operator access ---
# Break-glass token (at least 32 random characters, e.g. `openssl rand -hex 32`).
# Day-to-day operators get named tokens from operatorctl (see the runbook).
OPERATOR_API_TOKEN=

# --- AI extractor ---
# Without a key the free heuristic extractor runs. Use a key with a spend limit.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT_SECONDS=10
EXTRACTOR=

# --- Pilot behaviour ---
# Default buyer location for the single-campus pilot (empty = always ask).
PILOT_DEFAULT_LOCATION=
DEAL_FOLLOWUP=true
DEAL_FOLLOWUP_DELAY=6h
DEAL_ANSWER_TTL=72h
FREE_DEALS=100
INTRO_SHARE_BUYER_CONTACT=false
DISCOVERY_MODE=OFF

# --- Error tracking (optional; Sentry protocol, e.g. self-hosted GlitchTip) ---
BACKEND_SENTRY_DSN=
AI_SENTRY_DSN=

# --- Backups (deploy/scripts/majo.sh backup) ---
# Days of local dumps to keep in deploy/backups.
BACKUP_KEEP_DAYS=14
# Optional off-server copy: an rclone remote:path configured on the server
# (for example b2:majo-backups). Empty = local copies only (not enough on
# their own: a lost server loses them too).
BACKUP_RCLONE_TARGET=
