# Copy this file to .env and fill in real values before running
# `docker compose up --build`. Never commit the real .env file.

APP_ENV=development
APP_PORT=8080

# Postgres connection string used by the backend when running outside Docker
# Compose (e.g. `go run ./cmd/server` locally against a local Postgres).
# Inside Docker Compose, this is set automatically to point at the
# `postgres` service instead.
DATABASE_URL=postgres://middleman:middleman@localhost:5432/middleman?sslmode=disable

AI_SERVICE_URL=http://localhost:8000

# Meta WhatsApp Cloud API credentials.
# See docs/architecture/whatsapp.md for what each of these is and how to
# obtain them from Meta Business Manager.
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret (App Dashboard > App settings > Basic). Used to verify the
# X-Hub-Signature-256 header on every webhook POST. REQUIRED unless
# APP_ENV=development; without it, anyone who can reach the webhook URL could
# impersonate buyers and vendors.
WHATSAPP_APP_SECRET=

# Phase 4A Step 4: shared operator secret protecting listing edit/publish/reject
# and listing media previews (sent as "Authorization: Bearer <token>").
# Required unless APP_ENV=development is set explicitly; at least 16 characters.
# The dashboard asks the operator for it; it is not baked into the build.
OPERATOR_API_TOKEN=

DASHBOARD_URL=http://localhost:3000

# --- Phase 4A.1: durable media ingestion ---
# Vendor photos/videos are downloaded from WhatsApp by a background worker
# (Postgres job table) and stored by the local-disk storage provider under
# MEDIA_STORAGE_DIR. Use a persistent volume: losing it loses the media.
# No public URLs are generated for stored media.
MEDIA_STORAGE_DIR=data/media
# Size limits in bytes: 5 MB images, 16 MB video (WhatsApp's inbound limits).
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_VIDEO_BYTES=16777216
# At startup, vendor media from this window with no asset and no job is enqueued.
MEDIA_BACKFILL_WINDOW=168h
# Durable job worker (in-process). Durations use Go syntax: 2s, 5m, 1h.
JOBS_POLL_INTERVAL=2s
JOBS_CONCURRENCY=2
JOBS_MAX_ATTEMPTS=8
JOBS_BACKOFF_BASE=30s
JOBS_BACKOFF_MAX=30m
JOBS_LEASE=5m

# --- Phase 4A.2: supply grouping ---
# Vendor photos/videos/captions/text sent within this time of a submission's
# first message can become ONE SupplySignal. Experiment parameter.
SUPPLY_GROUPING_WINDOW=120s
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Phase 4A.5: supply lifecycle, freshness, geographic expansion [PARAM] ---
# See docs/architecture/supply-lifecycle.md. Invalid combinations stop startup.
# These are NOT the WhatsApp media retrieval window (~7 days, a provider limit
# handled by the media download job).
# Freshness: a listing whose last verification is older than this is STALE
# (still eligible, needs reconfirmation). Not an expiry.
SUPPLY_FRESHNESS_WINDOW=72h
# Lifecycle: a published listing is marketplace supply for this many days
# after publication, then it is expired (kept as history, never deleted).
SUPPLY_MAX_LIFECYCLE_DAYS=60
# Geographic expansion: day (since publication) each search scope begins.
# Must satisfy local <= nearby <= state <= region <= max lifecycle.
SUPPLY_GEO_LOCAL_DAYS=0
SUPPLY_GEO_NEARBY_DAYS=20
SUPPLY_GEO_STATE_DAYS=30
SUPPLY_GEO_REGION_DAYS=45

# --- Phase 4B: Discovery & Distribution foundation (INTERNAL ONLY) ---
# See docs/architecture/discovery-distribution.md. Invalid combinations stop startup.
# OFF (default): nothing is sent. INTERNAL: operator-triggered sends to the staff
# allowlist below ONLY. CONTROLLED_PILOT / ON are rejected until Phase 4C.
DISCOVERY_MODE=OFF
# Comma-separated staff/test WhatsApp numbers (wa_id). The only possible recipients.
DISCOVERY_INTERNAL_RECIPIENTS=
# Presentation arms (A/B). Assignment is a deterministic hash of the delivery.
DISCOVERY_ARMS=ARM_A,ARM_B
# Frequency cap: at most N delivered discoveries per buyer per period.
DISCOVERY_MAX_DELIVERIES_PER_BUYER=1
DISCOVERY_CAP_PERIOD=72h
# A listing already shown to a buyer is not shown again within this window.
DISCOVERY_EXPOSURE_WINDOW=336h
DISCOVERY_LISTINGS_PER_DELIVERY=3
# Optional delivery window, local time, e.g. 09:00-20:00 (may cross midnight). Empty = always open.
DISCOVERY_DELIVERY_WINDOW=
DISCOVERY_TIMEZONE=Africa/Lagos
# How long a button/list tap stays valid after the message was sent.
DISCOVERY_INTERACTION_TTL=168h
# After "Not interested", that category is down-ranked for this long.
DISCOVERY_NEGATIVE_WINDOW=720h
# Approved WhatsApp template used outside the 24h window (none = fail closed, skip).
DISCOVERY_TEMPLATE_NAME=
DISCOVERY_TEMPLATE_LANGUAGE=en
# Versioned consent-prompt wording recorded with every opt-in.
DISCOVERY_CONSENT_WORDING=v1
# (DISCOVERY_ENQUIRY_CONFIRMATION is retired: discovery enquiries are confirmed
#  by the autonomous runtime — see AUTO_CONFIRM_CLEAR_REQUESTS below.)
# Optional ranking override, e.g. category=30,product=25,exposure=-15 (integers -100..100).
DISCOVERY_RANKING_WEIGHTS=
# Re-upload an outbound media asset to WhatsApp after this long (provider limit ~30 days); Go durations, hours not days.
DISCOVERY_OUTBOUND_MEDIA_TTL=600h

# --- Phase 4C correction: autonomous runtime ---
# Majo is autonomous by default. Operators are control-plane participants and
# exception handlers, not normal transaction processors. Each flag switches
# ONE autonomous path off (the path still exists; OFF falls back to the
# operator-driven behaviour of earlier phases).
AUTO_CONFIRM_CLEAR_REQUESTS=true
AUTO_ROUTE_DISCOVERY_REQUESTS=true
AUTO_ROUTE_MATCHED_REQUESTS=true
AUTO_RESOLVE_VENDOR_CONTEXT=true
AUTO_CLARIFY_REQUESTS=true
# Requires AUTO_RESOLVE_VENDOR_CONTEXT=true.
AUTO_CLARIFY_VENDOR_RESPONSES=true
AUTO_RETRY_DELIVERY=true
# Gated by evidence (Lock): a vendor qualifies after >= 95% of its last 20
# operator-curated drafts were approved unchanged. Off until that evidence exists.
AUTO_PUBLISH_TRUSTED_VENDOR_LISTINGS=false
# Policy parameters (starting hypotheses).
AUTO_CONFIRM_MIN_CONFIDENCE=0.45
AUTO_CLARIFY_MAX_QUESTIONS=3
AUTO_CLARIFICATION_TTL=24h
# 45: category (30) + the buyer's area as a vendor service area (17) is
# enough to contact a vendor who has not posted stock yet.
AUTO_ROUTE_MIN_SCORE=45
AUTO_ROUTE_MAX_VENDORS=3
AUTO_ROUTE_VENDOR_MAX_OPEN=5
# Deadline of a SENT vendor request. A durable job fires at sent_at + TTL:
# the request becomes EXPIRED and the buyer's request is recovered
# (alternative vendors / ask to broaden / tell the buyer). Phase 4C hardening.
VENDOR_REQUEST_TTL=72h
AUTO_VENDOR_CLARIFY_MAX_ROUNDS=2
# Bounded retries of transient send failures (max 20).
AUTO_RETRY_MAX_ATTEMPTS=5
AUTO_CONTEXT_WINDOW=72h

# --- Phase 4C hardening ---
# When every contacted vendor went quiet / was unreachable / declined:
# contact eligible alternatives. false = record only (operator runs the step).
AUTO_RECOVER_STALLED_REQUESTS=true
# Re-routing rounds per request after silence (1-5).
AUTO_RECOVERY_MAX_ROUNDS=2
# Total vendors ever contacted for one request (>= AUTO_ROUTE_MAX_VENDORS, <= 20).
AUTO_ROUTE_MAX_VENDORS_PER_REQUEST=6
# A buyer update kept because it could not be delivered (e.g. 24h window
# closed) is cancelled instead of sent if older than this.
AUTO_PENDING_NOTICE_TTL=72h
# A reply that clearly names a request that expired within this window is
# still taken as its reply (the buyer's request must still be open).
AUTO_LATE_REPLY_WINDOW=72h
# Optional: one first-retry delay for every failure class (default: per class,
# 5s transport, 60s rate limit / provider unavailable, 5m per-recipient limit).
# AUTO_RETRY_FIRST_DELAY=
# Pilot batch: one-campus pilot. When a buyer gives no location and Majo
# knows none for them, the request is taken to be for this place instead of
# asking "where are you?". Use a name the gazetteer and vendors' service
# areas use (e.g. "Benin City"). Empty = keep asking. OWNER DECISION.
# PILOT_DEFAULT_LOCATION=
# Optional: comma-separated categories Majo never offers to search outside
# the buyer's area (e.g. furniture). Default: none. OWNER DECISION.
# AUTO_BROADEN_EXCLUDED_CATEGORIES=
# Optional: replaces the default restricted-items list (whole words); "off"
# disables it. Demand naming one is held for review, never auto-routed.
# OWNER DECISION: confirm the list.
# AUTO_RESTRICTED_ITEM_TERMS=

# --- Reuse audit R1: operator access, CORS, error tracking ---
# Named operator tokens (preferred over the shared OPERATOR_API_TOKEN):
#   DATABASE_URL=... go run ./cmd/operatorctl create -name "Ada" -role OPERATOR   # or -role VIEWER
#   DATABASE_URL=... go run ./cmd/operatorctl list | revoke -name "Ada"
# Every /api route needs a token; VIEWER tokens can only read.
# Browser origins allowed to call the API (comma-separated). Default: DASHBOARD_URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Error tracking pilot (GlitchTip or any Sentry-protocol endpoint). Empty = off.
# Reports are scrubbed (phone numbers, tokens, e-mails, request bodies).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# --- LLM provider (docs/architecture/llm-providers.md) ---
# LLM_PROVIDER=gemini | anthropic | none (empty: whichever key is set,
# Anthropic first). Keep keys in .env.local only; never commit them.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# LLM_PROVIDER=

# --- AI extractor (pilot batch) ---
# With a key, buyer messages are read by the Anthropic model; without one, by
# the free heuristic. Any API failure falls back to the heuristic (the message
# is never lost). Set a monthly spend limit on the key in the Anthropic
# console. Keep the key in .env.local only; never commit it.
# ANTHROPIC_API_KEY=
# Model (default claude-haiku-5-5). Change it here, not in code.
# ANTHROPIC_MODEL=claude-haiku-5-5
# Seconds before a model call gives up and the heuristic is used.
# ANTHROPIC_TIMEOUT_SECONDS=10
# EXTRACTOR=heuristic forces the free heuristic even with a key set.
# EXTRACTOR=

# --- Tone layer (pilot batch item 7) ---
# Buyer messages rephrased in a natural Nigerian register by the model above;
# facts (prices, numbers, names, links, reply keywords) can never change: on
# any doubt the template text is sent. See docs/architecture/tone-layer.md.
# off (default) | shadow (rewrite and store it, send the template) | on
# TONE_LAYER=off
# Backend: how long to wait for a rewrite before sending the template.
# TONE_TIMEOUT=5s
# AI service: model for rewrites (empty = ANTHROPIC_MODEL), and its timeout.
# TONE_MODEL=
# TONE_TIMEOUT_SECONDS=4

# --- Monetization scaffold (pilot batch item 8) ---
# Everything off: Majo takes no money in Stage A. A line switched on before
# its stage and payment provider stops startup (docs/architecture/ledger.md).
# MONETIZATION_STAGE=A
# PAYMENTS_PROVIDER=none
# FEATURE_LEAD_CREDITS=false
# FEATURE_VENDOR_PRO=false
# FEATURE_VERIFIED_BADGE=false
# FEATURE_RUSH_REQUEST=false
# FEATURE_SPONSORED=false
# FEATURE_SPLIT_PAYMENTS=false
# FEATURE_ESCROW=false

# --- Vendor request template (pilot batch item 3) ---
# Approved Meta utility template for vendor requests outside WhatsApp's
# 24-hour window. Wording to submit: docs/pilot/whatsapp-templates.md.
# Empty = free text only (vendors who have not written in 24h are missed).
# VENDOR_REQUEST_TEMPLATE_NAME=majo_vendor_request
# VENDOR_REQUEST_TEMPLATE_LANGUAGE=en

# --- Deals: introduction, follow-up, ratings, free-deal counter (pilot batch item 5) ---
# When a buyer chooses an offer, Majo gives the buyer the seller's WhatsApp
# link (plus safety advice) and tells the seller. DEAL_FOLLOWUP_DELAY later it
# asks both "did you buy / did you sell?"; two YESes make a confirmed deal.
# DEAL_FOLLOWUP=true
# Keep under 24h so the question reaches the buyer inside WhatsApp's window.
# DEAL_FOLLOWUP_DELAY=6h
# How long Majo waits for answers before settling the deal.
# DEAL_ANSWER_TTL=72h
# Confirmed deals numbered up to this are marked free (Stage A). OWNER DECISION.
# FREE_DEALS=100
# true = the seller also gets the buyer's WhatsApp link. Default false: the
# buyer gets the seller's link and makes contact. OWNER DECISION.
# INTRO_SHARE_BUYER_CONTACT=false
