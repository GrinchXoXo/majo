meta {
  name: Vendors
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/vendors
  body: none
  auth: inherit
}

script:post-response {
  if (Array.isArray(res.getBody()) && res.getBody().length > 0) {
    bru.setVar("vendorId", res.getBody()[0].id);
  }
}

tests {
  test("answers 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
